    "faq": {
      "type": "collapsible-content",
      "blocks": {
        "size": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What size should I order?",
            "icon": "ruler",
            "row_content": "<p>Our sizing runs small, so size up. If you normally wear a 34B, order a 36B. We carry bands 32 to 40 and cups A through E. For measuring instructions, see <a href=\"/pages/find-your-fit\" title=\"Find your fit\">Find your fit</a>.</p>"
          }
        },
        "show": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Will it show under a fitted top?",
            "icon": "shirt",
            "row_content": "<p>The edges are bonded rather than stitched, so there is no ridge or seam line. Under most fitted tops and light dresses it is not visible. Skin and Black are both available.</p>"
          }
        },
        "allday": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Can I wear it strapless all day?",
            "icon": "stopwatch",
            "row_content": "<p>Yes. It is designed for a full day and evening. The silicone grip runs the full length of the band and the wide underband carries the load, so it holds without needing to be tight. If the band slips, the size is probably too big, not too small.</p>"
          }
        },
        "wrong": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What if the size is wrong?",
            "icon": "return",
            "row_content": "<p>Exchange it. Exchanges are free within 30 days of delivery, we cover return shipping and there are no restocking fees. Start from the <a href=\"/pages/returns\" title=\"Returns and exchanges\">returns page</a>.</p>"
          }
        },
        "wash": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How do I wash it?",
            "icon": "washing",
            "row_content": "<p>Hand wash cold with a mild detergent and hang to dry. Keep it out of the hot dryer, which breaks down the silicone grip and bonded edges over time.</p>"
          }
        }
      },
      "block_order": [
        "size",
        "show",
        "allday",
        "wrong",
        "wash"
      ],
