    "how-it-stays-up": {
      "type": "multirow",
      "blocks": {
        "grip": {
          "type": "row",
          "settings": {
            "caption": "01",
            "heading": "Silicone grip along the band",
            "text": "<p>A soft silicone strip runs the full length of the band, top and bottom. It holds to skin without pulling, so the bra stays where you put it instead of working its way down through the day.</p>",
            "button_label": "",
            "button_link": ""
          }
        },
        "underband": {
          "type": "row",
          "settings": {
            "caption": "02",
            "heading": "The wide bonded underband does the work",
            "text": "<p>Most strapless bras hold on by being tight. Ours holds because the underband is wide and bonded, so the load spreads across the whole band. Firm, not pinching.</p>",
            "button_label": "",
            "button_link": ""
          }
        },
        "edges": {
          "type": "row",
          "settings": {
            "caption": "03",
            "heading": "Seamless edges disappear under fitted tops",
            "text": "<p>The edges are bonded rather than stitched, so there is no ridge to show through a fitted top or a light dress.</p>",
            "button_label": "Find your fit",
            "button_link": "/pages/find-your-fit"
          }
        }
      },
      "block_order": [
        "grip",
        "underband",
        "edges"
