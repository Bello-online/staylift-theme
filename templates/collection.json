          }
        },
        "exchanges": {
          "type": "item",
          "settings": {
            "icon": "return",
            "heading": "Free exchanges within 30 days",
            "text": "Return shipping covered, no restocking fees"
          }
        },
        "sizing": {
          "type": "item",
          "settings": {
            "icon": "ruler",
            "heading": "Runs small, size up",
            "text": "If you normally wear a 34B, order a 36B"
          }
        }
      },
      "block_order": [
        "shipping",
        "exchanges",
        "sizing"
      ],
      "settings": {
        "color_scheme": "scheme-2",
        "padding_top": 28,
        "padding_bottom": 28
      }
    }
