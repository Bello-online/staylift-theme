          "settings": {
            "heading": "Between two sizes? Take the larger.",
            "text": "<p>The wide underband does the holding, so it does not need to be tight to stay put. If the band slips, the size is too big, not too small.</p>"
          }
        },
        "tip_lotion": {
          "type": "tip",
          "settings": {
            "heading": "Put it on before lotion.",
            "text": "<p>The grip works against clean skin. Lotion, oil or powder on the band line will loosen it.</p>"
          }
        }
