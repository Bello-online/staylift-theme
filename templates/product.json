      "settings": {
        "heading": "Find your fit",
        "intro": "<p>Our sizing runs small, so size up. If you normally wear a 34B, order a 36B. If you are a medium in most brands, take a large here.</p><p>Bands 32 to 40, cups A through E, in Skin and Black. If it is not right, exchanges are free within 30 days and we cover return shipping.</p>",
        "show_table": true,
        "table_caption": "Starting guide for the StayLift Strapless Bra. Band measurements are in inches. We are still confirming these against real fittings, so if you are between sizes, take the larger.",
        "label_size": "Size",
        "label_band": "Band (inches)",
        "label_cup": "Cup",
        "label_usual": "If you usually wear",
        "measure_heading": "Measuring at home",
        "measure_text": "<p><strong>Band:</strong> measure snugly around your ribcage, just under the bust, and round to the nearest even number.</p><p><strong>Cup:</strong> measure loosely around the fullest part of your bust. Each inch of difference between that and your band is one cup size (1 = A, 2 = B, 3 = C, 4 = D, 5 = E).</p>",
        "color_scheme": "scheme-2",
        "tip_color_scheme": "scheme-1",
        "padding_top": 56,
        "padding_bottom": 56
      }
