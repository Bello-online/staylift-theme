{{ 'section-hold-explainer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hold-explainer.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="hold-explainer color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="hold-explainer__header{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- if section.settings.heading != blank -%}
          <h2 class="hold-explainer__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <div class="hold-explainer__subheading rte">{{ section.settings.subheading }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <hold-explainer class="hold-explainer__body hold-explainer__body--image-{{ section.settings.image_position }}">
      <div class="hold-explainer__media{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <div class="hold-explainer__figure{% if section.settings.image == blank %} hold-explainer__figure--placeholder{% endif %}">
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 1600
              | image_tag:
                width: section.settings.image.width,
                height: section.settings.image.height,
                class: 'hold-explainer__image',
                widths: '400, 600, 800, 1000, 1200, 1600',
                sizes: '(min-width: 990px) 50vw, 100vw',
                loading: 'lazy'
            }}
          {%- else -%}
            {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg hold-explainer__image' }}
          {%- endif -%}

          {%- for block in section.blocks -%}
            <button
              type="button"
              class="hold-explainer__marker{% if forloop.first %} is-active{% endif %}"
              id="HoldMarker-{{ section.id }}-{{ forloop.index }}"
              style="left: {{ block.settings.x }}%; top: {{ block.settings.y }}%;"
              data-hold-index="{{ forloop.index0 }}"
              aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-controls="HoldPoint-{{ section.id }}-{{ forloop.index }}"
              {{ block.shopify_attributes }}
            >
              <span class="hold-explainer__marker-number" aria-hidden="true">{{ forloop.index }}</span>
              <span class="visually-hidden">{{ block.settings.heading | escape }}</span>
            </button>
          {%- endfor -%}
        </div>
      </div>

      <ol class="hold-explainer__list{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- for block in section.blocks -%}
          <li
            class="hold-explainer__item{% if forloop.first %} is-active{% endif %}"
            id="HoldPoint-{{ section.id }}-{{ forloop.index }}"
            data-hold-index="{{ forloop.index0 }}"
          >
            <button
              type="button"
              class="hold-explainer__item-trigger"
              data-hold-index="{{ forloop.index0 }}"
              aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
            >
              <span class="hold-explainer__item-number" aria-hidden="true">{{ forloop.index }}</span>
              <span class="hold-explainer__item-heading">{{ block.settings.heading | escape }}</span>
            </button>
            {%- if block.settings.text != blank -%}
              <div class="hold-explainer__item-text rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    </hold-explainer>
  </div>
</div>

{% schema %}
{
  "name": "Hold explainer",
  "tag": "section",
  "class": "section section-hold-explainer",
  "max_blocks": 5,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How it stays up"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>It holds because of how it is built, not how tight it is. Tap a number to see what each part does.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "A square image works best. Markers are placed by percentage from the top left corner."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position on desktop",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "limit": 5,
      "settings": [
        {
          "type": "range",
          "id": "x",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Horizontal position",
          "default": 50
        },
        {
          "type": "range",
          "id": "y",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Vertical position",
          "default": 50
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Silicone grip along the band"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>A soft silicone strip runs the full length of the band. It holds to skin without pulling.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hold explainer",
      "blocks": [
        {
          "type": "point",
          "settings": { "x": 50, "y": 66 }
        },
        {
          "type": "point",
          "settings": {
            "x": 24,
            "y": 60,
            "heading": "Wide bonded underband",
            "text": "<p>The underband is wide and bonded, so the load spreads across the whole band. Firm, not pinching.</p>"
          }
        },
        {
          "type": "point",
          "settings": {
            "x": 68,
            "y": 38,
            "heading": "Seamless bonded edges",
            "text": "<p>The edges are bonded rather than stitched, so there is no ridge to show through a fitted top.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
